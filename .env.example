# ─── AI Resume Builder – Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key-too
JWT_EXPIRES_HOURS=24

# Database
# SQLite (default – development)
DEV_DATABASE_URL=sqlite:///instance/dev.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_resume_builder

# File Uploads
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=5242880
